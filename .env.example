# Copy to .env.local and fill in.

# Google Maps JavaScript API key (browser). Restrict it to your site's referrers
# and to: Maps JavaScript API, Places API (New).
NEXT_PUBLIC_MAPS_API_KEY=
# Map ID (JavaScript type). Required for Advanced Markers. "DEMO_MAP_ID" works for local testing.
NEXT_PUBLIC_MAPS_MAP_ID=

# Gemini API key (server only). https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Falls back to gemini-3.1-flash-lite, then gemini-2.5-flash-lite, if this model is unavailable.
GEMINI_MODEL=gemini-3.5-flash-lite

# Site password (HTTP Basic Auth, any username). Required in production —
# without it the deployed site returns 503. Leave empty locally to skip the prompt.
SITE_PASSWORD=
